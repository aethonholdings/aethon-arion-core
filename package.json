{
  "name": "aethon-arion-core",
  "version": "0.1.1",
  "description": "The Arion project core classes",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "watch": "tsc -w & nodemon -q -w dist dist/index.js",
    "test": "ts-node node_modules/jasmine/bin/jasmine --config=./tests/jasmine.json --reporter=jasmine-console-reporter"
  },
  "homepage": "https://arion.aethon.sg",
  "author": "Konstantinos Dimitriou <konstantinos.dimitriou@aethon.sg>",
  "license": "MIT",
  "dependencies": {
    "ml-matrix": "^6.11.0",
    "rxjs": "~7.8.1"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.20.0",
    "@typescript-eslint/parser": "^6.20.0",
    "@types/jasmine": "^5.1.4",
    "@types/node": "^20.11.14",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jasmine": "^5.1.0",
    "jasmine-console-reporter": "^3.1.0",
    "jasmine-reporters": "^2.5.2",
    "prettier": "^3.2.4",
    "ts-node": "^10.9.2",
    "typedoc": "^0.26.6",
    "typedoc-plugin-markdown": "^4.2.6",
    "typescript": "^5.5.2"
  }
}
